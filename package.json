{
  "name": "pi-modes",
  "version": "0.1.0",
  "description": "Plan and manager modes for pi: read-only planning with a review step, and a read-only manager agent that drives isolated worker agents.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "pnpm test:types && pnpm test:lint && pnpm test:unit",
    "test:types": "tsc --noEmit",
    "test:lint": "eslint --fix .",
    "test:unit": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@raidou/eslint-config-base": "4.4.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "shell-quote": "^1.8.3",
    "typebox": "1.3.9"
  }
}
