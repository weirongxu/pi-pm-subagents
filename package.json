{
  "name": "@raidou/pi-pm-subagents",
  "version": "0.3.3",
  "description": "Coordinator mode for pi: a read-only coordinator agent that drives isolated subagents, including a planner role.",
  "keywords": [
    "coordinator",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pm",
    "subagents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weirongxu/pi-pm-subagents.git"
  },
  "files": [
    "src",
    "agents",
    "README.zh-CN.md",
    "example-prompts",
    "pm-subagents-prompts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "pnpm test:types && pnpm test:lint && pnpm test:unit",
    "test:types": "tsc --noEmit",
    "test:lint": "echo '[test:lint] may rewrite files' && oxfmt --write && oxlint --fix",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@raidou/oxlint-config-base": "^0.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "26.1.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.0.0",
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0",
    "typebox": ">=1.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
